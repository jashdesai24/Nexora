PORT=3001
NODE_ENV=development

# Indian API — Primary data provider for Indian equities
# Get your free key at: https://indianapi.in
# Used for: stock quotes, company data, financial news
INDIAN_API_KEY=

# Alpha Vantage — Backup/future market data (unreliable for Indian markets)
# Get your free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=

# LLM Providers (add keys when available)
# Gemini — Primary LLM for Jarvis
GEMINI_API_KEY=
# Grok — Backup LLM
GROK_API_KEY=

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173
